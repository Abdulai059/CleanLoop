datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}


enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum HouseholdRole {
  HEAD
  MEMBER
}

enum RecoveryStatus {
  VERIFIED
  VOIDED
}

enum WalletTransactionType {
  EARN
  REDEEM
  ADJUSTMENT
  REVERSAL
}

enum RewardStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum RedemptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum SchoolStaffRole {
  ADMIN
  STAFF
}

enum SchoolCollectionScope {
  SCHOOL
  CLASS
}

enum CampaignType {
  SCHOOL
  CLASS
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  phone String @unique
  email String? @unique

  passwordHash String

  gender Gender?

  status UserStatus @default(PENDING)

  dateOfBirth DateTime?

  profilePhotoUrl String?

  regionId String?
  districtId String?
  communityId String?

  region Region? @relation(fields: [regionId], references: [id])
  district District? @relation(fields: [districtId], references: [id])
  community Community? @relation(fields: [communityId], references: [id])

  householdMemberships HouseholdMember[]

  roles UserRole[]
  recordedRecoveries Recovery[] @relation("RecoveryRecordedBy")
  redemptions Redemption[] 

  schoolStaffMemberships SchoolStaff[]
recordedSchoolCollections SchoolCollection[] @relation("SchoolCollectionRecordedBy")

  wallet Wallet?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]

  passwordResetToken  String?
  passwordResetExpires DateTime?
}


model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Region {
  id String @id @default(cuid())

  name String @unique

  districts District[]

  users User[]

  schools School[]

  createdAt DateTime @default(now())
}

model District {
  id String @id @default(cuid())

  name String

  regionId String

  region Region @relation(fields: [regionId], references: [id])

  communities Community[]

  users User[]

  schools School[]

  createdAt DateTime @default(now())

  @@unique([regionId, name])
}

model Community {
  id String @id @default(cuid())

  name String

  districtId String

  district District @relation(fields: [districtId], references: [id])

  households Household[]

  users User[]

  schools School[]

  createdAt DateTime @default(now())

  @@unique([districtId, name])
}

model Household {
  id String @id @default(cuid())

  name String

  communityId String

  community Community @relation(fields: [communityId], references: [id])

  latitude Decimal? @db.Decimal(10,7)
  longitude Decimal? @db.Decimal(10,7)

  recoveries Recovery[]

  members HouseholdMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HouseholdMember {
  householdId String
  userId String

  role HouseholdRole @default(MEMBER)

  joinedAt DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([householdId, userId])
}



model MaterialType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  recoveryItems RecoveryItem[]
  pointRules    PointRule[] 

  schoolCollectionItems SchoolCollectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Recovery {
  id String @id @default(cuid())

  householdId  String
  recordedById String

  status RecoveryStatus @default(VERIFIED)

  totalWeight Decimal @db.Decimal(10, 2)
  totalPoints Int @default(0)

  household Household @relation(fields: [householdId], references: [id])
  recordedBy User @relation("RecoveryRecordedBy", fields: [recordedById], references: [id])

  items RecoveryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([recordedById])
  @@index([status])
  @@index([createdAt])
}


model RecoveryItem {
  id String @id @default(cuid())

  recoveryId     String
  materialTypeId String

  weight Decimal @db.Decimal(10, 2)

  recovery Recovery @relation(fields: [recoveryId], references: [id], onDelete: Cascade)
  materialType MaterialType @relation(fields: [materialTypeId], references: [id])

  createdAt DateTime @default(now())

  @@index([recoveryId])
  @@index([materialTypeId])
}


model PointRule {
  id String @id @default(cuid())

  materialTypeId String

  pointsPerKg Decimal @db.Decimal(10, 2)

  isActive Boolean @default(true)

  materialType MaterialType @relation(fields: [materialTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([materialTypeId])
}

model Wallet {
  id String @id @default(cuid())

  userId String @unique

  balance Decimal @default(0) @db.Decimal(12, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id String @id @default(cuid())

  walletId String

  type WalletTransactionType

  amount Decimal @db.Decimal(12, 2)

  balanceAfter Decimal @db.Decimal(12, 2)

  referenceId String?
  description String?

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([referenceId])
  @@index([createdAt])
}


model Reward {
  id String @id @default(cuid())

  name        String
  description String?

  pointsCost Int

  imageUrl String?

  status RewardStatus @default(ACTIVE)

  stockQuantity Int?

  redemptions Redemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Redemption {
  id String @id @default(cuid())

  userId   String
  rewardId String

  pointsSpent Int

  status RedemptionStatus @default(PENDING)

  failureReason String?

  user User @relation(fields: [userId], references: [id])

  reward Reward @relation(fields: [rewardId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([rewardId])
  @@index([status])
  @@index([createdAt])
}

model School {
  id String @id @default(cuid())

  name String

  regionId    String?
  districtId  String?
  communityId String?

  region    Region?    @relation(fields: [regionId], references: [id])
  district  District?  @relation(fields: [districtId], references: [id])
  community Community? @relation(fields: [communityId], references: [id])

  isActive Boolean @default(true)

  staff       SchoolStaff[]
  classes     SchoolClass[]
  collections SchoolCollection[]
  participants CampaignParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtId])
  @@index([communityId])
}

model SchoolStaff {
  schoolId String
  userId   String

  role SchoolStaffRole @default(ADMIN)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@id([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
}

model SchoolClass {
  id String @id @default(cuid())

  schoolId String
  name     String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  collections  SchoolCollection[]
  participants CampaignParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}


model SchoolCollection {
  id String @id @default(cuid())

  schoolId String
  classId  String?

  recordedById String

  scope SchoolCollectionScope

  totalWeight Decimal @db.Decimal(10, 2)
  totalPoints Int @default(0)

  campaignId String?

  school     School       @relation(fields: [schoolId], references: [id])
  class      SchoolClass? @relation(fields: [classId], references: [id])
  campaign   Campaign?    @relation(fields: [campaignId], references: [id])
  recordedBy User         @relation("SchoolCollectionRecordedBy", fields: [recordedById], references: [id])

  items SchoolCollectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@index([recordedById])
  @@index([campaignId])
  @@index([createdAt])
}


model SchoolCollectionItem {
  id String @id @default(cuid())

  collectionId   String
  materialTypeId String

  weight Decimal @db.Decimal(10, 2)
  points Int @default(0)

  collection   SchoolCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  materialType MaterialType     @relation(fields: [materialTypeId], references: [id])

  createdAt DateTime @default(now())

  @@index([collectionId])
  @@index([materialTypeId])
}


model Campaign {
  id String @id @default(cuid())

  name        String
  description String?

  type CampaignType

  startDate DateTime
  endDate   DateTime

  status CampaignStatus @default(DRAFT)

  collections  SchoolCollection[]
  participants CampaignParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startDate])
  @@index([endDate])
}


model CampaignParticipant {
  id String @id @default(cuid())

  campaignId String
  schoolId   String
  classId    String?

  campaign Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  school   School      @relation(fields: [schoolId], references: [id])
  class    SchoolClass? @relation(fields: [classId], references: [id])

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([schoolId])
  @@index([classId])
  @@unique([campaignId, schoolId, classId])
}